{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/jzz.html" },
    { "source": "/index.html", "destination": "/jzz.html" },
    { "source": "/zz.html", "destination": "/jzz.html" },
